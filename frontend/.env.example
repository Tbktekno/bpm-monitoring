# =============================================================================
# BPM & SpO₂ Monitoring Dashboard — Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in values.
# All VITE_ prefixed variables are embedded at build time.
# =============================================================================

# ─── API Configuration ──────────────────────────────────────────────────────
# Base URL for REST API calls (used by axios)
# Development: http://localhost:5000/api/v1
# Production (behind nginx): /api/v1 (relative path)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ─── WebSocket Configuration ────────────────────────────────────────────────
# Socket.IO server URL (empty = same origin auto-detection)
# Development: http://localhost:5000
# Production (behind nginx): (leave empty for auto-detect)
VITE_SOCKET_URL=http://localhost:5000
