# =============================================================================
# BPM & SpO₂ Monitoring Dashboard — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# For production, DO NOT commit the actual .env file.
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (development):
#   DATABASE_URL="file:./dev.db"
# PostgreSQL (production):
#   DATABASE_URL="postgresql://user:password@host:5432/bpm_monitoring"
DATABASE_URL="postgresql://bpm_user:changeme@postgres:5432/bpm_monitoring"

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT Configuration ──────────────────────────────────────────────────────
# MUST be >= 64 characters in production for HS256 security
JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-sixty-four-characters-long
JWT_EXPIRES_IN=24h          # Default session expiry
JWT_REMEMBER_EXPIRES_IN=7d  # "Remember me" session expiry
JWT_ISSUER=bpm-monitoring

# ─── gRPC ───────────────────────────────────────────────────────────────────
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# ─── CORS ───────────────────────────────────────────────────────────────────
# Frontend origin(s) allowed to make cross-origin requests
CORS_ORIGIN=http://localhost:5173

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug              # debug | info | warn | error
LOG_DIR=./logs
